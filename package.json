{
  "name": "claude-ui",
  "version": "0.4.6",
  "description": "A desktop UI for Claude Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder"
  },
  "author": "891458249",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.3",
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.claudeui.app",
    "productName": "Claude UI",
    "copyright": "Copyright © 2026 891458249",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "891458249",
      "repo": "Drafter"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "Claude UI"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude UI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
