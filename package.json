{
  "name": "drafter",
  "version": "0.11.12",
  "description": "Drafter — AI desktop workbench: fast chat, coding agent and media creation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder"
  },
  "author": "891458249",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "drawflow": "^0.0.60",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.3",
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.drafter.app",
    "productName": "Drafter",
    "copyright": "Copyright © 2026 891458249",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "vendor/deepseek-harness/package.json",
      "vendor/deepseek-harness/pnpm-workspace.yaml",
      "vendor/deepseek-harness/apps/cli/package.json",
      "vendor/deepseek-harness/apps/cli/config/**/*",
      "vendor/deepseek-harness/apps/web/dist/**/*",
      "vendor/deepseek-harness/packages/**/package.json",
      "vendor/deepseek-harness/packages/**/lib/**/*",
      "vendor/deepseek-harness/packages/**/cordis.patch.yml",
      "vendor/deepseek-harness/vendor/**/package.json",
      "vendor/deepseek-harness/vendor/**/lib/**/*",
      "vendor/deepseek-harness/native/**/package.json",
      "vendor/deepseek-harness/native/**/lib/**/*",
      "vendor/deepseek-harness/vendor-deps/**/*",
      "!vendor/**/*.tsbuildinfo",
      "!vendor/**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "891458249",
      "repo": "Drafter"
    },
    "asarUnpack": [
      "vendor/deepseek-harness/**/lib/**",
      "vendor/deepseek-harness/apps/web/dist/**",
      "vendor/deepseek-harness/apps/cli/config/**",
      "vendor/deepseek-harness/**/cordis.patch.yml",
      "vendor/deepseek-harness/**/package.json",
      "vendor/deepseek-harness/native/**/lib/**",
      "vendor/deepseek-harness/vendor-deps/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "Drafter"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Drafter",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
